// Cloudflare settings for the GalaxySMP website.
// Secrets (DATABASE_URL, PLUGIN_SECRET) are NOT stored here. They are added in the
// Cloudflare dashboard under: Worker > Settings > Variables and Secrets.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "galaxysmp",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,

  // Pages, styles and scripts in /public are packed into the Worker before each deploy.
  "build": { "command": "node scripts/build-assets.mjs", "watch_dir": ["public", "src/lib", "src/routes", "src/chat", "src/voice", "src/store"] },

  // Keep variables that were added in the dashboard when a new version is deployed.
  "keep_vars": true,

  // Non-secret settings.
  "vars": {
    // These Minecraft names automatically become Admin when they link their account.
    "OWNER_USERNAMES": "Ashcore2261,.VisionDevs"
  },

  // Live chat: one Durable Object (SQLite-backed, available on the free plan).
  "durable_objects": {
    "bindings": [
      { "name": "HUB", "class_name": "CommunityHub" },
      { "name": "VOICE", "class_name": "VoiceHub" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CommunityHub"] },
    { "tag": "v2", "new_sqlite_classes": ["VoiceHub"] }
  ],

  // Free built-in rate limiters (per visitor IP) for sign-in and code requests.
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "POLL_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],

  "observability": { "enabled": true }
}
