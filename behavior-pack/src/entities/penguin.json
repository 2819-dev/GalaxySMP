        },
        "minecraft:behavior.tempt": {
          "priority": 4, "speed_multiplier": 1.1,
          "items": [ "minecraft:cod", "minecraft:salmon", "minecraft:tropical_fish", "minecraft:cooked_cod", "minecraft:cooked_salmon" ]
        }
      },
      "galaxysmp:tame": {
        "minecraft:is_tamed": {},
        "minecraft:sittable": {},
        "minecraft:behavior.stay_while_sitting": { "priority": 3 },
        "minecraft:behavior.follow_owner": { "priority": 5, "speed_multiplier": 1.3, "start_distance": 8, "stop_distance": 2 },
        "minecraft:behavior.owner_hurt_by_target": { "priority": 1 },
        "minecraft:behavior.owner_hurt_target": { "priority": 2 },
        "minecraft:behavior.hurt_by_target": { "priority": 2 },
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 3, "must_see": true, "reselect_targets": true, "within_radius": 12,
          "entity_types": [ { "filters": { "test": "is_family", "subject": "other", "value": "monster" }, "max_dist": 12 } ]
        },
        "minecraft:behavior.melee_attack": { "priority": 3, "speed_multiplier": 1.4, "track_target": true },
        "minecraft:attack": { "damage": 8 },
        "minecraft:healable": {
          "items": [
            { "item": "minecraft:cod", "heal_amount": 8 }, { "item": "minecraft:salmon", "heal_amount": 8 },
            { "item": "minecraft:tropical_fish", "heal_amount": 6 }, { "item": "minecraft:cooked_cod", "heal_amount": 12 },
            { "item": "minecraft:cooked_salmon", "heal_amount": 12 }
          ]
        }
      }
    },
    "components": {
      "minecraft:type_family": { "family": [ "penguin", "galaxysmp_pet", "mob" ] },
      "minecraft:collision_box": { "width": 0.5, "height": 0.95 },
      "minecraft:health": { "value": 40, "max": 40 },
      "minecraft:movement": { "value": 0.25 },
      "minecraft:underwater_movement": { "value": 0.12 },
      "minecraft:movement.amphibious": { "max_turn": 15 },
      "minecraft:navigation.generic": { "can_path_over_water": false, "can_swim": true, "can_walk": true, "can_sink": false, "avoid_damage_blocks": true },
      "minecraft:breathable": { "total_supply": 30, "suffocate_time": 0, "breathes_water": true, "breathes_air": true },
