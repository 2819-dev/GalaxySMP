      "minecraft:physics": {},
      "minecraft:pushable": { "is_pushable": true, "is_pushable_by_piston": true },
      "minecraft:nameable": {},
      "minecraft:persistent": {},
      "minecraft:damage_sensor": { "triggers": [ { "cause": "drowning", "deals_damage": false }, { "cause": "freezing", "deals_damage": false } ] },
      "minecraft:behavior.random_swim": { "priority": 8, "speed_multiplier": 1.0, "interval": 60 },
      "minecraft:behavior.random_stroll": { "priority": 7, "speed_multiplier": 0.9 },
      "minecraft:behavior.look_at_player": { "priority": 9, "look_distance": 6, "probability": 0.02 },
