// GalaxySMP join screens. A menu whose title has the hidden marker §g§s§m§p fills the screen:
//   §1 title screen (logo, splash, buttons, your character), §2 Featured Servers (list + sidebar: button 0 = Join Server
//   with the selected server's banner, button 1 = ping/players line, the rest = the list), §3 info pages, §4 joining animation.
//   §o§<1-6> picks the 3D background scene (none = the valley), §m§<1-9,a> the joining block (none = grass).
// Every other menu looks exactly like Minecraft's. Art: render3d.py / scenes.py / draw_join.py / draw_ui_icons.py.
{
 "namespace": "server_form",
 "third_party_server_screen@common.base_screen": {
  "$screen_content": "server_form.main_screen_content",
  "$screen_bg_content": "server_form.gsmp_screen_bg",
  "button_mappings": [
   {
    "from_button_id": "button.menu_cancel",
    "to_button_id": "button.menu_exit",
    "mapping_type": "global"
   }
  ]
 },
 "main_screen_content": {
  "type": "panel",
  "size": [
   "100%",
   "100%"
  ],
  "controls": [
   {
    "server_form_factory": {
     "type": "factory",
     "control_ids": {
      "long_form": "@server_form.long_form",
      "custom_form": "@server_form.custom_form"
     }
    }
   }
  ]
 },
 "long_form": {
  "type": "panel",
  "size": [
   "100%",
   "100%"
  ],
  "controls": [
   {
    "vanilla@server_form.gsmp_vanilla_long_form": {
     "bindings": [
      {
       "binding_name": "#title_text"
      },
      {
       "binding_type": "view",
       "source_property_name": "((#title_text - '§g§s§m§p') = #title_text)",
       "target_property_name": "#visible"
      }
     ]
    }
   },
   {
    "title_screen@server_form.gsmp_title_screen": {
     "bindings": [
      {
       "binding_name": "#title_text"
      },
      {
       "binding_type": "view",
       "source_property_name": "(not ((#title_text - '§g§s§m§p§1') = #title_text))",
       "target_property_name": "#visible"
      }
     ]
    }
   },
   {
    "servers_screen@server_form.gsmp_servers_screen": {
     "bindings": [
      {
       "binding_name": "#title_text"
      },
      {
       "binding_type": "view",
       "source_property_name": "(not ((#title_text - '§g§s§m§p§2') = #title_text))",
       "target_property_name": "#visible"
      }
     ]
    }
   },
   {
    "page_screen@server_form.gsmp_page_screen": {
     "bindings": [
      {
       "binding_name": "#title_text"
      },
      {
       "binding_type": "view",
       "source_property_name": "(not ((#title_text - '§g§s§m§p§3') = #title_text))",
       "target_property_name": "#visible"
      }
     ]
    }
   },
   {
    "joining_screen@server_form.gsmp_joining_screen": {
     "bindings": [
      {
       "binding_name": "#title_text"
      },
      {
       "binding_type": "view",
       "source_property_name": "(not ((#title_text - '§g§s§m§p§4') = #title_text))",
       "target_property_name": "#visible"
      }
     ]
    }
   }
  ]
 },
