{
  "namespace": "server_form",

  // GalaxySMP join screens. A menu (ActionForm) whose title contains a hidden marker fills the whole screen:
  //   §g§s§m§p§1  title screen: panning night landscape, the GalaxySMP logo, a splash line and big buttons
  //   §g§s§m§p§2  Featured Servers: server cards with a picture, description and who's playing
  //   §g§s§m§p§3  info page (How to Play, Rules, What's New): tabs on the left, text on the right
  // Every other menu looks exactly like Minecraft's (Mojang's long_form, copied below as gsmp_vanilla_long_form).
  // The plugin sends them on every join (endstone-plugin/src/endstone_galaxylink/welcome.py).
  // Art: textures/ui/gsmp_title_bg, gsmp_srv_*, gsmp_card* (resource-pack/draw_title.py).

  "main_screen_content": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "server_form_factory": {
          "type": "factory",
          "control_ids": {
            "long_form": "@server_form.long_form",
            "custom_form": "@server_form.custom_form"
          }
        }
      }
    ]
  },

  "long_form": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "vanilla@server_form.gsmp_vanilla_long_form": {
          "bindings": [
            { "binding_name": "#title_text" },
            { "binding_type": "view", "source_property_name": "((#title_text - '§g§s§m§p') = #title_text)", "target_property_name": "#visible" }
          ]
        }
      },
      {
        "title_screen@server_form.gsmp_title_screen": {
          "bindings": [
            { "binding_name": "#title_text" },
            { "binding_type": "view", "source_property_name": "(not ((#title_text - '§g§s§m§p§1') = #title_text))", "target_property_name": "#visible" }
          ]
        }
      },
      {
        "servers_screen@server_form.gsmp_servers_screen": {
          "bindings": [
            { "binding_name": "#title_text" },
            { "binding_type": "view", "source_property_name": "(not ((#title_text - '§g§s§m§p§2') = #title_text))", "target_property_name": "#visible" }
          ]
        }
      },
      {
        "page_screen@server_form.gsmp_page_screen": {
          "bindings": [
            { "binding_name": "#title_text" },
            { "binding_type": "view", "source_property_name": "(not ((#title_text - '§g§s§m§p§3') = #title_text))", "target_property_name": "#visible" }
          ]
        }
      }
    ]
  },

  // Mojang's long_form, unchanged
  "gsmp_vanilla_long_form@common_dialogs.main_panel_no_buttons": {
    "$title_panel": "common_dialogs.standard_title_label",
    "$title_size": [ "100% - 15px", 10 ],
    "$title_max_size": [ "100% - 15px", 10 ],
    "size": [ 225, 200 ],
    "$text_name": "#title_text",
    "$title_text_binding_type": "none",
    "$child_control": "server_form.long_form_panel",
    "layer": 2
  },

  // ---------- shared pieces ----------
  "gsmp_pan_a": { "anim_type": "offset", "easing": "in_out_sine", "duration": 40, "from": [ 0, 0 ], "to": [ "-50%", 0 ], "next": "@server_form.gsmp_pan_b" },
  "gsmp_pan_b": { "anim_type": "offset", "easing": "in_out_sine", "duration": 40, "from": [ "-50%", 0 ], "to": [ 0, 0 ], "next": "@server_form.gsmp_pan_a" },

  // the slowly panning night landscape, with a dark layer on top ($dim: 0 = none)
  "gsmp_backdrop": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "clips_children": true,
    "$dim|default": 0.0,
    "controls": [
      {
        "landscape": {
          "type": "image",
          "texture": "textures/ui/gsmp_title_bg",
          "bilinear": false,
          "size": [ "150%", "100%" ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": "@server_form.gsmp_pan_a",
          "layer": 1
        }
      },
      {
        "shade": {
          "type": "image",
          "texture": "textures/ui/Black",
          "alpha": "$dim",
          "size": [ "100%", "100%" ],
          "layer": 2
        }
      }
    ]
  },

  // Minecraft-style button (the game's own button look)
  "gsmp_mc_button": {
    "type": "panel",
    "size": [ "100%", 28 ],
    "controls": [
      {
        "button@common_buttons.light_text_button": {
          "$pressed_button_name": "button.form_button_click",
          "size": [ "100%", 24 ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "$button_text": "#form_button_text",
          "$button_text_binding_type": "collection",
          "$button_text_grid_collection_name": "form_buttons",
          "$button_text_max_size": [ "100% - 8px", 20 ],
          "bindings": [ { "binding_type": "collection_details", "binding_collection_name": "form_buttons" } ]
        }
      }
    ]
  },

  "gsmp_mc_buttons": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [ "100%", "100%c" ],
    "factory": { "name": "buttons", "control_ids": { "button": "@server_form.gsmp_mc_button" } },
    "collection_name": "form_buttons",
    "bindings": [ { "binding_name": "#form_button_contents", "binding_name_override": "#collection_length" } ]
  },

  // "< Back" in the top-left corner: closes the menu, and the plugin opens the title screen again
  "gsmp_back@common_buttons.light_text_button": {
    "$pressed_button_name": "button.menu_exit",
    "size": [ 56, 20 ],
    "anchor_from": "left_middle",
    "anchor_to": "left_middle",
    "$button_text": "< Back",
    "$button_text_binding_type": "none"
  },

  "gsmp_header": {
    "type": "panel",
    "size": [ "100%", 26 ],
    "$header_text|default": "#title_text",
    "controls": [
      { "back@server_form.gsmp_back": {} },
      {
        "title": {
          "type": "label",
          "text": "$header_text",
          "shadow": true,
          "font_scale_factor": 1.25,
          "color": [ 1.0, 1.0, 1.0 ],
          "anchor_from": "center",
          "anchor_to": "center",
          "bindings": [ { "binding_name": "#title_text" } ]
        }
      }
    ]
  },

  // ---------- 1. title screen ----------
  "gsmp_title_screen": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "layer": 2,
    "controls": [
      { "backdrop@server_form.gsmp_backdrop": { "layer": 1 } },
      {
        "middle": {
          "type": "stack_panel",
          "orientation": "vertical",
          "size": [ 220, "100%c" ],
          "anchor_from": "center",
          "anchor_to": "center",
          "offset": [ 0, -6 ],
          "layer": 10,
          "controls": [
            {
              "logo": {
                "type": "image",
                "texture": "textures/ui/galaxysmp_logo",
                "bilinear": false,
                "keep_ratio": true,
                "size": [ "100%", 42 ]
              }
            },
            {
              "splash": {
                "type": "label",
                "text": "#form_text",
                "color": [ 1.0, 1.0, 0.33 ],
                "shadow": true,
                "text_alignment": "center",
                "size": [ "100%", "default" ],
                "bindings": [ { "binding_name": "#form_text" } ]
              }
            },
            { "gap": { "type": "panel", "size": [ "100%", 12 ] } },
            { "buttons@server_form.gsmp_mc_buttons": {} }
          ]
        }
      },
      {
        "site": {
          "type": "label",
          "text": "galaxymc.us",
          "shadow": true,
          "color": [ 0.85, 0.9, 1.0 ],
          "anchor_from": "bottom_left",
          "anchor_to": "bottom_left",
          "offset": [ 4, -3 ],
          "layer": 10
        }
      },
      {
        "made": {
          "type": "label",
          "text": "GalaxySMP Network",
          "shadow": true,
          "color": [ 0.85, 0.9, 1.0 ],
          "anchor_from": "bottom_right",
          "anchor_to": "bottom_right",
          "offset": [ -4, -3 ],
          "layer": 10
        }
      }
    ]
  },

  // ---------- 2. Featured Servers ----------
  "gsmp_servers_screen": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "layer": 2,
    "controls": [
      { "backdrop@server_form.gsmp_backdrop": { "layer": 1, "$dim": 0.55 } },
      {
        "page": {
          "type": "stack_panel",
          "orientation": "vertical",
          "size": [ "100% - 24px", "100% - 10px" ],
          "anchor_from": "center",
          "anchor_to": "center",
          "layer": 10,
          "controls": [
            { "header@server_form.gsmp_header": { "$header_text": "Featured Servers" } },
            {
              "hint": {
                "type": "label",
                "text": "#form_text",
                "color": [ 0.75, 0.8, 0.95 ],
                "text_alignment": "center",
                "size": [ "100%", "default" ],
                "bindings": [ { "binding_name": "#form_text" } ]
              }
            },
            { "gap": { "type": "panel", "size": [ "100%", 4 ] } },
            {
              "list": {
                "type": "panel",
                "size": [ "100%", "fill" ],
                "controls": [
                  {
                    "scroll@common.scrolling_panel": {
                      "size": [ "100%", "100%" ],
                      "$show_background": false,
                      "$scrolling_content": "server_form.gsmp_server_cards",
                      "$scroll_size": [ 4, "100% - 4px" ],
                      "$scrolling_pane_size": [ "100% - 6px", "100%" ],
                      "$scrolling_pane_offset": [ 0, 0 ],
                      "$scroll_bar_right_padding_size": [ 0, 0 ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  "gsmp_server_cards": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [ "100%", "100%c" ],
    "factory": { "name": "buttons", "control_ids": { "button": "@server_form.gsmp_server_card" } },
    "collection_name": "form_buttons",
    "bindings": [ { "binding_name": "#form_button_contents", "binding_name_override": "#collection_length" } ]
  },

  "gsmp_server_card": {
    "type": "panel",
    "size": [ "100%", 66 ],
    "controls": [
      {
        "card@common.button": {
          "$pressed_button_name": "button.form_button_click",
          "size": [ "100%", 62 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "bindings": [ { "binding_type": "collection_details", "binding_collection_name": "form_buttons" } ],
          "controls": [
            { "default@server_form.gsmp_card_face": { "$card_texture": "textures/ui/gsmp_card" } },
            { "hover@server_form.gsmp_card_face": { "$card_texture": "textures/ui/gsmp_card_hover" } },
            { "pressed@server_form.gsmp_card_face": { "$card_texture": "textures/ui/gsmp_card_pressed" } }
          ]
        }
      }
    ]
  },

  "gsmp_card_face": {
    "type": "image",
    "texture": "$card_texture",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "row": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "size": [ "100% - 8px", 54 ],
          "anchor_from": "center",
          "anchor_to": "center",
          "controls": [
            {
              "picture": {
                "type": "image",
                "size": [ 96, 54 ],
                "bilinear": false,
                "layer": 2,
                "bindings": [
                  { "binding_name": "#form_button_texture", "binding_name_override": "#texture", "binding_type": "collection", "binding_collection_name": "form_buttons" },
                  { "binding_name": "#form_button_texture_file_system", "binding_name_override": "#texture_file_system", "binding_type": "collection", "binding_collection_name": "form_buttons" }
                ]
              }
            },
            { "gap": { "type": "panel", "size": [ 8, "100%" ] } },
            {
              "text": {
                "type": "panel",
                "size": [ "fill", "100%" ],
                "controls": [
                  {
                    "label": {
                      "type": "label",
                      "text": "#form_button_text",
                      "shadow": true,
                      "color": [ 1.0, 1.0, 1.0 ],
                      "size": [ "100%", "default" ],
                      "anchor_from": "left_middle",
                      "anchor_to": "left_middle",
                      "layer": 3,
                      "bindings": [ { "binding_name": "#form_button_text", "binding_type": "collection", "binding_collection_name": "form_buttons" } ]
                    }
                  }
                ]
              }
            },
            {
              "join": {
                "type": "label",
                "text": "§aJoin §f>",
                "shadow": true,
                "size": [ 34, "100%" ],
                "text_alignment": "right",
                "layer": 3
              }
            }
          ]
        }
      }
    ]
  },

  // ---------- 3. info page (How to Play, Rules, What's New) ----------
  "gsmp_page_screen": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "layer": 2,
    "controls": [
      { "backdrop@server_form.gsmp_backdrop": { "layer": 1, "$dim": 0.6 } },
      {
        "page": {
          "type": "stack_panel",
          "orientation": "vertical",
          "size": [ "100% - 24px", "100% - 10px" ],
          "anchor_from": "center",
          "anchor_to": "center",
          "layer": 10,
          "controls": [
            { "header@server_form.gsmp_header": {} },
            { "gap": { "type": "panel", "size": [ "100%", 4 ] } },
            {
              "body": {
                "type": "stack_panel",
                "orientation": "horizontal",
                "size": [ "100%", "fill" ],
                "controls": [
                  {
                    "tabs": {
                      "type": "panel",
                      "size": [ "30%", "100%" ],
                      "controls": [
                        {
                          "scroll@common.scrolling_panel": {
                            "size": [ "100%", "100%" ],
                            "$show_background": false,
                            "$scrolling_content": "server_form.gsmp_mc_buttons",
                            "$scroll_size": [ 4, "100% - 4px" ],
                            "$scrolling_pane_size": [ "100% - 6px", "100%" ],
                            "$scrolling_pane_offset": [ 0, 0 ],
                            "$scroll_bar_right_padding_size": [ 0, 0 ]
                          }
                        }
                      ]
                    }
                  },
                  { "gap": { "type": "panel", "size": [ 6, "100%" ] } },
                  {
                    "text_box": {
                      "type": "image",
                      "texture": "textures/ui/gsmp_card",
                      "size": [ "fill", "100%" ],
                      "controls": [
                        {
                          "scroll@common.scrolling_panel": {
                            "size": [ "100% - 8px", "100% - 8px" ],
                            "anchor_from": "center",
                            "anchor_to": "center",
                            "$show_background": false,
                            "$scrolling_content": "server_form.gsmp_text",
                            "$scroll_size": [ 4, "100% - 4px" ],
                            "$scrolling_pane_size": [ "100% - 6px", "100%" ],
                            "$scrolling_pane_offset": [ 2, 0 ],
                            "$scroll_bar_right_padding_size": [ 0, 0 ]
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  "gsmp_text": {
    "type": "panel",
    "size": [ "100%", "100%c + 6px" ],
    "controls": [
      {
        "label": {
          "type": "label",
          "text": "#form_text",
          "color": [ 0.93, 0.95, 1.0 ],
          "shadow": true,
          "size": [ "100% - 6px", "default" ],
          "offset": [ 3, 3 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "bindings": [ { "binding_name": "#form_text" } ]
        }
      }
    ]
  }
}
